# TinyFish is used only from trusted server runtimes.
TINYFISH_API_KEY=

# Optional server-only answer composer. Both settings are required to enable it.
# Model/provider are fixed in code: google/gemma-4-26b-a4b-it on nextbit/bf16.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=

# Photon Spectrum Cloud credentials. Never expose these to the web app.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Local proof defaults.
COURSESIGNAL_TIME_ZONE=Asia/Dubai
COURSESIGNAL_LOG_LEVEL=info

# Durable bridge state defaults to the local JSON file store. Supabase is used
# only when this value is explicitly changed to "supabase".
COURSESIGNAL_STORE=json

# Required only with COURSESIGNAL_STORE=supabase. Both values are server-only;
# the service-role key must never be exposed to browser bundles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
